<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则。
  导入的 HTML 文件位于 filesDir/htmls/，属于用户数据，允许参与云备份与换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="htmls/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="htmls/" />
    </device-transfer>
</data-extraction-rules>
